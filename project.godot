; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Swinburne Simulator"
config/version="0.5.1"
run/main_scene="res://Views/MainMenu.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
run/max_fps=60
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0.0666667, 0.133333, 1)
boot_splash/image="res://Resources/Backgrounds/splash.png"
config/icon="res://Resources/icon.svg"

[audio]

buses/default_bus_layout="res://Audio/BusLayout.tres"

[autoload]

BackgroundMusic="*res://Audio/BackgroundMusic.tscn"
SceneTransition="*res://Views/SceneTransition.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/ios/allow_high_refresh_rate=false
mouse_cursor/size/viewport_height=648
mouse_cursor/size/viewport_width=1152

[dotnet]

project/assembly_name="Swinburne Simulator"

[gui]

theme/custom="res://Resources/UITheme.tres"

